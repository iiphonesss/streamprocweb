generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ImportedProduct {
  id           String   @id @default(cuid())
  sku          String   @unique
  name         String
  brand        String?
  category     String?
  faceValue    Decimal?
  faceCurrency String?
  description  String?
  images       Json
  isActive     Boolean  @default(true)
  rawData      Json
  importedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DigitizationResult {
  id                    String   @id @default(cuid())
  productSku            String
  sourceImageUrl        String
  originalPath          String?
  cleanWithFramePath    String?
  cleanWithoutFramePath String?
  frameAssetPath        String?
  frameAnalysisJson     Json?
  textRegionsJson       Json?
  masksJson             Json?
  selectedBaseMode      String?
  status                String   @default("draft")
  frameExtractionStatus String?
  analysisSummaryJson   Json?
  aiRequestCount        Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([productSku])
}

model CardTemplate {
  id               String   @id @default(cuid())
  name             String
  sourceSku        String
  digitizationId   String?
  baseMode         String
  baseImagePath    String
  frameAssetPath   String?
  frameEnabled     Boolean  @default(true)
  canvasJson       Json
  textRegionsJson  Json
  textStylesJson   Json
  addedObjectsJson Json?
  status           String   @default("draft")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sourceSku])
}

model GeneratedCard {
  id         String    @id @default(cuid())
  templateId String
  productSku String?
  dataJson   Json
  outputPath String?
  status     String    @default("draft")
  approvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([templateId])
}
